# Másold le ezt a fájlt .env néven, és írd át a saját adataidra!
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biztonsag

# A JWT aláírásához használt titkos kulcs (legalább 32 karakter). Ilyet így generálhatsz:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ide-irj-egy-hosszu-veletlen-szoveget
JWT_LEJARAT=1h
