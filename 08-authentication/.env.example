# Másold le ezt a fájlt .env néven, és írd át a saját adataidra!
# A .env fájl NEM kerül fel a Git-re (.gitignore), a .env.example igen.

# A webszerver portja
PORT=3000

# MySQL (XAMPP) kapcsolat
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auth_pelda

# A JWT aláírásához használt titkos kulcs. Legyen hosszú és véletlenszerű!
# Ilyet így generálhatsz:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ide-irj-egy-hosszu-veletlen-szoveget

# Mennyi ideig érvényes a token (pl. 15m, 1h, 7d)
JWT_LEJARAT=1h
